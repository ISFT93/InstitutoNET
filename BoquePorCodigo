using System; using System.Data; using ISFDyT93.Datos.Core; using ISFDyT93.Datos.Modelos;

namespace ISFDyT93.Datos.Daos { public class AniosCarreraDao : DaoBase { // Obtiene los años pertenecientes a una carrera específica. // Ahora también trae CodigoBloque como columna [Código], // para que en la grilla se vea el código del año. // Ejemplo: carrera 01 + año 1 = 011. public DataTable ObtenerAniosCarrera(int carreraId) { string query = "SELECT " + "CodigoBloque AS [Año], " + "AnioCarreraId, " + //"AnioCarrera AS [Año], " + "CantidadMaterias AS [Cantidad de Materias], " + "CargaHorariaCompleta AS [Carga Horaria Completa] " + "FROM AniosCarreras " + "WHERE CarreraId = " + carreraId + " " + "ORDER BY AnioCarrera";

        return this.Conexion.ObtenerRegistros(query);
        /*
        string query = "SELECT AnioCarreraId,AnioCarrera AS [Año],CantidadMaterias AS [Cantidad de Materias],CargaHorariaCompleta AS [Carga Horaria Completa] FROM AniosCarreras WHERE CarreraId = " + carreraId;

        return this.Conexion.ObtenerRegistros(query);*/
    }
    // Agrega un nuevo año a una carrera.
    // Además de guardar AnioCarrera y CarreraId,
    // genera automáticamente el CodigoBloque del año.
    // El código se forma uniendo el CodigoBloque de la carrera
    // con el número de año.
    public int AgregarAnio(int anioCarrera, int carreraId)
    {
        string query =
         "INSERT INTO AniosCarreras (AnioCarrera, CarreraId, CodigoBloque) " +
         "SELECT " +
         anioCarrera + ", " +
         carreraId + ", " +
         "C.CodigoBloque + CAST(" + anioCarrera + " AS VARCHAR(1)) " +
         "FROM Carreras C " +
         "WHERE C.CarreraId = " + carreraId;

        return this.Conexion.EjecutarAccion(query);
        /*
        string query = "INSERT INTO AniosCarreras (AnioCarrera, CarreraId) VALUES(" + anioCarrera + "," + carreraId + ")";
            
        return this.Conexion.EjecutarAccion(query);*/
    }

    // Elimina un año de carrera según su Id interno.
    // Borra el registro de la tabla AniosCarreras.
    // Se usa cuando se elimina un año cargado en una carrera.
    public int EliminarAnios(int anioCarreraId)
    {
        string query = "DELETE AniosCarreras WHERE AnioCarreraId = " + anioCarreraId;

        return this.Conexion.EjecutarAccion(query);
    }

    // Actualiza la cantidad de materias y la carga horaria total de un año.
    // Cuenta cuántas materias tiene ese año.
    // También suma la carga horaria de todas sus materias.
    // Luego guarda esos valores en AniosCarreras.
    public int ActualizarCargaHoria(int anioCarreraId)
    {
        string query = "UPDATE AniosCarreras SET CantidadMaterias = (SELECT COUNT(MateriaId) FROM Materias WHERE AnioCarreraId =" + anioCarreraId+")," +
        "CargaHorariaCompleta = (SELECT SUM(CargaHoraria) FROM Materias WHERE AnioCarreraId = " + anioCarreraId + ") WHERE AnioCarreraId = " + anioCarreraId;
        
        return this.Conexion.EjecutarAccion(query);
    }
    // Obtiene los años de las carreras activas de un alumno.
    // Relaciona AniosCarreras, Carreras y AlumnosCarreras.
    // Se usa para saber qué años corresponden al alumno inscripto.
    public DataTable ObtenerAnios(int alumnoId)
    {
        string query = "SELECT AC.AnioCarreraId, AC.AnioCarrera FROM AniosCarreras AC " +
          "INNER JOIN Carreras C ON AC.CarreraId = C.CarreraId " +
          "INNER JOIN AlumnosCarreras ALC ON C.CarreraId = ALC.CarreraId WHERE ALC.AlumnoId =" + alumnoId + " AND ALC.Activo = 1";

        return this.Conexion.ObtenerRegistros(query);
    }
    // Obtiene la suma total de la carga horaria de todos los años de una carrera.
    // Devuelve un número entero.
    // Si no encuentra datos o hay error, devuelve 0.
    public int ObtenerCargaHoraria(int CarreraId)
    {
        string query = "SELECT SUM(CargaHorariaCompleta) as CargaHoraria FROM AniosCarreras WHERE CarreraId = "+ CarreraId;
        var row = this.Conexion.ObtenerRegistro(query);
        try
        {
            if (row != null)
            {
                return Convert.ToInt32(row["CargaHoraria"]);
            }
            return 0;
        }
        catch
        {
            return 0;
        }
    }
    // Obtiene el CarreraId al que pertenece un año de carrera.
    // Recibe un AnioCarreraId y devuelve la carrera asociada.
    public DataRow ObtenerCarrera(int AnioCarreraId)
    {
        string query = "SELECT CarreraId from AniosCarreras where AnioCarreraId=" + AnioCarreraId;
        return this.Conexion.ObtenerRegistro(query);
    }
    // Obtiene todos los datos de un año de carrera específico.
    // También trae el nombre corto de la carrera y su estado.
    // Luego convierte el resultado a un modelo AniosCarrerasModelo.
    public AniosCarrerasModelo ObtenerAnioCarrera(int anioCarreraId)
    {
        string query = $"SELECT A.*, C.DescripcionCorta AS NombreCarrera, C.CarreraEstadoId FROM AniosCarreras A INNER JOIN Carreras C ON A.CarreraId = C.CarreraId where AnioCarreraId = { anioCarreraId }";
        return this.MapToModel<AniosCarrerasModelo>(this.Conexion.ObtenerRegistro(query));
    }
    // Obtiene solamente el número de año.
    // Recibe el AnioCarreraId y devuelve AnioCarrera.
    // Si no encuentra datos, devuelve 0.

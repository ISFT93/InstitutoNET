    // Agrega una nueva carrera a la base de datos.
    // Primero crea el INSERT automáticamente a partir del modelo.
    // Después genera el CodigoBloque de forma automática.
    // Finalmente devuelve el resultado de la inserción.
    public int AgregarCarreras(CarrerasModelo modelo)
    {
        // Crea la consulta INSERT usando los datos del modelo.
        string query = this.CreateInsertQuery<CarrerasModelo>(modelo);
        // Ejecuta el INSERT y guarda el resultado.
        int resultado = this.Conexion.EjecutarAccion(query);
        // Consulta adicional para generar el código de bloque de la carrera nueva.
        string actualizarCodigo =
            "DECLARE @NuevoCarreraId INT; " +
            "DECLARE @NuevoCodigo VARCHAR(2); " +
            // Toma el último CarreraId insertado.
            "SELECT @NuevoCarreraId = MAX(CarreraId) " +
            "FROM Carreras; " +

            // Busca el mayor CodigoBloque existente y le suma 1.
            // RIGHT('00' + ...) asegura que quede con dos dígitos, por ejemplo 01, 02, 10.
            "SELECT @NuevoCodigo = RIGHT('00' + CAST(ISNULL(MAX(CAST(CodigoBloque AS INT)), 0) + 1 AS VARCHAR(2)), 2) " +
            "FROM Carreras " +
            "WHERE ISNUMERIC(CodigoBloque) = 1; " +
            // Actualiza la carrera recién agregada con el nuevo código generado.
            "UPDATE Carreras " +
            "SET CodigoBloque = @NuevoCodigo " +
            "WHERE CarreraId = @NuevoCarreraId;";

        this.Conexion.EjecutarAccion(actualizarCodigo);

        return resultado;
        /*
        string query = this.CreateInsertQuery<CarrerasModelo>(modelo);

        return this.Conexion.EjecutarAccion(query);*/
    }

